---
/**
 * Sav <head>: meta, kanonski, hreflang, Open Graph, JSON-LD.
 *
 * og:image MORA biti apsolutan — relativan URL Facebook i X tiho ignoriraju.
 * og:locale traži hr_HR (podvlaka), hreflang traži hr (crtica). To su dvije
 * različite gramatike i obje su ispravne na svom mjestu.
 */
import { site, jezici, apsolutno } from '../site.config.mjs';
import { jsonLdOsnovni } from '../core/rad.mjs';

interface Props {
  naslov: string;
  opis: string;
  jezik?: 'hr' | 'en';
  /** Apsolutne putanje iste stranice po jeziku, npr. { hr: '/radovi/x/', en: '/en/works/y/' } */
  prijevodi?: Partial<Record<'hr' | 'en', string>>;
  ogSlika?: string;
  ogSlikaAlt?: string;
  ogTip?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: unknown[];
}

const {
  naslov,
  opis,
  jezik = 'hr',
  prijevodi,
  ogSlika,
  ogSlikaAlt,
  ogTip = 'website',
  noindex = false,
  jsonLd = [],
} = Astro.props;

const kanonski = apsolutno(Astro.url.pathname);
const slika = ogSlika ?? apsolutno('/social/zadana-og.jpg');

// Osnovni @graph ide na svaku stranicu; specifični čvorovi se dodaju po stranici.
const sviCvorovi = [jsonLdOsnovni(), ...jsonLd];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{naslov}</title>
<meta name="description" content={opis} />
<link rel="canonical" href={kanonski} />

{
  noindex
    ? <meta name="robots" content="noindex, follow" />
    : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
}

{/* hreflang iz jedne mape prijevoda — recipročni linkovi se ne mogu razići.
    Emitira se samo kad prijevod STVARNO postoji. */}
{prijevodi?.hr && <link rel="alternate" hreflang="hr" href={apsolutno(prijevodi.hr)} />}
{prijevodi?.en && <link rel="alternate" hreflang="en" href={apsolutno(prijevodi.en)} />}
{prijevodi?.hr && <link rel="alternate" hreflang="x-default" href={apsolutno(prijevodi.hr)} />}

<meta property="og:type" content={ogTip} />
<meta property="og:site_name" content={site.naziv} />
<meta property="og:url" content={kanonski} />
<meta property="og:title" content={naslov} />
<meta property="og:description" content={opis} />
<meta property="og:image" content={slika} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{ogSlikaAlt && <meta property="og:image:alt" content={ogSlikaAlt.slice(0, 420)} />}
<meta property="og:locale" content={jezici.og[jezik]} />
{prijevodi?.en && jezik === 'hr' && <meta property="og:locale:alternate" content={jezici.og.en} />}
{prijevodi?.hr && jezik === 'en' && <meta property="og:locale:alternate" content={jezici.og.hr} />}

{/* twitter:* koristi name=, og:* koristi property=. Miješanje je najčešći
    uzrok "kartica radi na Facebooku, ne radi na X-u". */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={naslov} />
<meta name="twitter:description" content={opis} />
<meta name="twitter:image" content={slika} />
{ogSlikaAlt && <meta name="twitter:image:alt" content={ogSlikaAlt.slice(0, 420)} />}

<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content="#F6EFE1" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#14120E" media="(prefers-color-scheme: dark)" />

{sviCvorovi.map((cvor) => (
  <script type="application/ld+json" set:html={JSON.stringify(cvor)} />
))}
